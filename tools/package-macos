#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"
if [ "$(uname -s)" != Darwin ]; then
  echo "请在 macOS 上构建应用" >&2
  exit 1
fi

nsh_cli=${NSH_CLI:-"$root/.tools/nsh/bin/nsh"}
nsh_home=$(CDPATH= cd -- "$(dirname "$nsh_cli")/.." && pwd)
mkdir -p .nsh/out
output=$(mktemp -d "$root/.nsh/out/macos.XXXXXX")

# macOS 27 rejects some compile-time Rust libraries after Cargo's debug-info strip.
CARGO_PROFILE_RELEASE_STRIP=${CARGO_PROFILE_RELEASE_STRIP:-none} \
  NSH_RUNTIME=${NSH_RUNTIME:-"$nsh_home/runtime"} "$nsh_cli" package --target macos --out "$output" .
app="$output/红果短剧-NSH.app"
resources="$app/Contents/Resources"
mkdir -p "$resources/licenses/hongguo"
cp LICENSE "$resources/licenses/PROJECT-LICENSE"
cp "$nsh_home/LICENSE-APACHE" "$resources/licenses/NSH-LICENSE-APACHE"
cp service/vendor/hongguo/LICENSE service/vendor/hongguo/NOTICE \
  service/vendor/hongguo/THIRD-PARTY-NOTICES.md "$resources/licenses/hongguo/"

test ! -e "$app/Contents/MacOS/node"
test ! -e "$resources/backend"
codesign --force --sign - "$app"
codesign --verify --deep --strict "$app"
printf '%s\n' "$app"
